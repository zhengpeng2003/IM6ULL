QWidget {
    background-color: #1E1E1E;
    color: #E0E0E0;
    font-size: 14px;
}

#TopStatusBar {
    background-color: #2B2B2B;
}

#BottomNavBar {
    background-color: #2B2B2B;
}

#NavButton {
    border: none;
    font-size: 18px;
}

#StatusGreen {
    background-color: #00C853;
    border-radius: 5px;
}
#ValueBox {
    background-color: #1F1F1F;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    min-width: 110px;
}

#ValueText {
    color: #E0E0E0;
    font-size: 14px;
}
#StatusGreen {
    background-color: #2ecc71;
    border-radius: 5px;
}

#StatusGray {
    background-color: #bdc3c7;
    border-radius: 5px;
}
