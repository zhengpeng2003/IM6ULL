QWidget {
    background-color: #F4F7FA;
    color: #1F2A37;
    font-size: 11px;
    font-family: "Microsoft YaHei", "WenQuanYi Micro Hei";
}

#MainWidget,
#PageArea {
    background-color: #F4F7FA;
}

#TopStatusBar,
#BottomNavBar {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
}

#TopStatusBar QLabel {
    color: #1F2A37;
    font-size: 13px;
    font-weight: bold;
}

#NavButton {
    border: none;
    color: #64748B;
    font-size: 13px;
    font-weight: bold;
    min-height: 30px;
    background-color: #FFFFFF;
}

#NavButton:pressed,
#NavButton:hover {
    color: #FFFFFF;
    background-color: #126CFF;
}

#SummaryBar,
#StatsBar {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 5px;
    color: #1F2A37;
    padding-left: 7px;
}

#Panel,
#DetailPanel,
#MetricCard,
#PortCard,
#EmptyPanel,
#TrendChart {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 5px;
}

#MetricPanel {
    background-color: transparent;
    border: none;
}

#PanelTitle,
#SectionTitle {
    color: #1F2A37;
    font-size: 12px;
    font-weight: bold;
}

#DetailTitle {
    color: #111827;
    font-size: 14px;
    font-weight: bold;
}

#DetailKey,
#HintText {
    color: #64748B;
    font-size: 10px;
}

#DetailValue {
    color: #1F2A37;
    font-size: 11px;
}

#MetricIcon {
    color: #126CFF;
    border: 1px solid #BBD4FF;
    border-radius: 12px;
    background-color: #EFF6FF;
    font-size: 12px;
    font-weight: bold;
}

#MetricValue {
    color: #111827;
    font-size: 18px;
    font-weight: bold;
}

#DetailStateBadge {
    color: #64748B;
    font-size: 13px;
    font-weight: bold;
    background-color: transparent;
}

#DetailStateBadge[state="online"] {
    color: #00A63E;
}

#DetailStateBadge[state="offline"] {
    color: #64748B;
}

#DetailValue[state="online"],
#SlaveState[state="online"],
QLabel[state="online"] {
    color: #009E8E;
}

#DetailValue[state="offline"],
#SlaveState[state="offline"],
QLabel[state="offline"] {
    color: #64748B;
}

#SlaveCard {
    background-color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 5px;
}

#SlaveCard[selected="true"] {
    border: 1px solid #8DBBFF;
    background-color: #EAF2FF;
}

#SlaveTitle {
    color: #1F2A37;
    font-size: 11px;
    font-weight: bold;
}

#SlaveState {
    color: #64748B;
    font-size: 10px;
}

#StateDot {
    border-radius: 3px;
    background-color: #94A3B8;
}

#StateDot[state="online"] {
    background-color: #00A63E;
}

#StateDot[state="offline"] {
    background-color: #94A3B8;
}

#AlarmBar {
    background-color: #FFF1F2;
    border: 1px solid #EF4444;
    border-radius: 5px;
    color: #B91C1C;
    padding-left: 7px;
}

#ActionButton,
#SmallActionButton {
    background-color: #126CFF;
    border: 1px solid #126CFF;
    border-radius: 4px;
    color: #FFFFFF;
    min-height: 22px;
    padding: 1px 7px;
}

#GhostButton,
#SmallGhostButton,
#ToggleButton {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 4px;
    color: #1F2A37;
    min-height: 22px;
    padding: 1px 7px;
}

#ToggleButton[checked="true"] {
    background-color: #126CFF;
    border-color: #126CFF;
    color: #FFFFFF;
}

#DangerButton {
    background-color: #FFF7ED;
    border: 1px solid #F97316;
    border-radius: 4px;
    color: #C2410C;
    min-height: 22px;
    padding: 1px 7px;
}

#ActionButton:disabled,
#GhostButton:disabled,
#SmallActionButton:disabled,
#SmallGhostButton:disabled,
#DangerButton:disabled {
    background-color: #E5EAF0;
    border-color: #D7DEE8;
    color: #94A3B8;
}

QComboBox,
#CompactCombo,
QLineEdit,
#CompactLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 4px;
    color: #1F2A37;
    min-height: 20px;
    padding-left: 5px;
}

QComboBox:disabled,
QLineEdit:disabled {
    color: #94A3B8;
    background-color: #E5EAF0;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    selection-background-color: #126CFF;
    selection-color: #FFFFFF;
}

#EmptyTitle {
    color: #1F2A37;
    font-size: 14px;
    font-weight: bold;
}

#StatusGreen {
    background-color: #00A63E;
    border-radius: 5px;
}

#StatusGray {
    background-color: #94A3B8;
    border-radius: 5px;
}

QScrollArea {
    border: none;
}

#SlaveListScrollArea,
#PopupScrollArea {
    background-color: transparent;
    border: none;
}

#SlaveListContent,
#PopupListContent {
    background-color: transparent;
}

#SlavePopup {
    background-color: #F4F7FA;
    border: 1px solid #D7DEE8;
}

#PopupTitle {
    color: #1F2A37;
    font-size: 13px;
    font-weight: bold;
}

#PopupCloseButton {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 4px;
    color: #1F2A37;
    font-size: 11px;
}

#PopupCloseButton:pressed,
#PopupCloseButton:hover {
    background-color: #FFF1F2;
    border-color: #EF4444;
    color: #B91C1C;
}

#SlavePopupRow {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 4px;
}

#SlavePopupRow:hover {
    border-color: #8DBBFF;
    background-color: #EAF2FF;
}

#PopupDetailStack {
    background-color: transparent;
    border: none;
}
