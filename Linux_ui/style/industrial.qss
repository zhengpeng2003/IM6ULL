QWidget {
    background-color: #101820;
    color: #EAF2F8;
    font-size: 11px;
}

#MainWidget,
#PageArea {
    background-color: #101820;
}

#TopStatusBar,
#BottomNavBar {
    background-color: #111923;
    border: 1px solid #2E4053;
}

#TopStatusBar QLabel {
    color: #EAF2F8;
    font-size: 12px;
}

#NavButton {
    border: none;
    color: #95A5A6;
    font-size: 12px;
    min-height: 30px;
    background-color: #111923;
}

#NavButton:pressed,
#NavButton:hover {
    color: #00BFA5;
    background-color: #1B2633;
}

#SummaryBar,
#StatsBar {
    background-color: #1B2633;
    border: 1px solid #2E4053;
    border-radius: 4px;
    color: #EAF2F8;
    padding-left: 7px;
}

#Panel,
#DetailPanel,
#PortCard,
#EmptyPanel,
#TrendChart {
    background-color: #1B2633;
    border: 1px solid #2E4053;
    border-radius: 4px;
}

#PanelTitle,
#SectionTitle {
    color: #EAF2F8;
    font-size: 13px;
    font-weight: bold;
}

#DetailKey,
#HintText {
    color: #95A5A6;
    font-size: 10px;
}

#DetailValue {
    color: #EAF2F8;
    font-size: 11px;
}

#DetailValue[state="online"],
#SlaveState[state="online"],
QLabel[state="online"] {
    color: #00BFA5;
}

#DetailValue[state="offline"],
#SlaveState[state="offline"],
QLabel[state="offline"] {
    color: #95A5A6;
}

#SlaveCard {
    background-color: #1B2633;
    border: 1px solid #2E4053;
    border-radius: 4px;
}

#SlaveCard[selected="true"] {
    border: 1px solid #00BFA5;
    background-color: #20323B;
}

#SlaveTitle {
    color: #EAF2F8;
    font-size: 11px;
    font-weight: bold;
}

#SlaveState {
    color: #95A5A6;
    font-size: 10px;
}

#AlarmBar {
    background-color: #4A1F24;
    border: 1px solid #FF5252;
    border-radius: 4px;
    color: #FFB3B3;
    padding-left: 7px;
}

#ActionButton,
#SmallActionButton {
    background-color: #00BFA5;
    border: 1px solid #00D7BB;
    border-radius: 4px;
    color: #071313;
    min-height: 22px;
    padding: 1px 7px;
}

#GhostButton,
#SmallGhostButton,
#ToggleButton {
    background-color: #1B2633;
    border: 1px solid #2E4053;
    border-radius: 4px;
    color: #EAF2F8;
    min-height: 22px;
    padding: 1px 7px;
}

#ToggleButton[checked="true"] {
    background-color: #00BFA5;
    border-color: #00D7BB;
    color: #071313;
}

#DangerButton {
    background-color: #5A2A22;
    border: 1px solid #C46A3A;
    border-radius: 4px;
    color: #FFD4C2;
    min-height: 22px;
    padding: 1px 7px;
}

#ActionButton:disabled,
#GhostButton:disabled,
#SmallActionButton:disabled,
#SmallGhostButton:disabled,
#DangerButton:disabled {
    background-color: #24313D;
    border-color: #2E4053;
    color: #647174;
}

QComboBox,
#CompactCombo,
QLineEdit,
#CompactLineEdit {
    background-color: #111923;
    border: 1px solid #2E4053;
    border-radius: 4px;
    color: #EAF2F8;
    min-height: 20px;
    padding-left: 5px;
}

QComboBox:disabled,
QLineEdit:disabled {
    color: #95A5A6;
    background-color: #18212B;
}

QComboBox QAbstractItemView {
    background-color: #111923;
    border: 1px solid #2E4053;
    selection-background-color: #00BFA5;
    selection-color: #071313;
}

#EmptyTitle {
    color: #EAF2F8;
    font-size: 14px;
    font-weight: bold;
}

#StatusGreen {
    background-color: #00BFA5;
    border-radius: 5px;
}

#StatusGray {
    background-color: #95A5A6;
    border-radius: 5px;
}

QScrollArea {
    border: none;
}
