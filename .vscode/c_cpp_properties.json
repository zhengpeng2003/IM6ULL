{
    "version":  4,
    "configurations":  [
                           {
                               "name":  "Qt qmake MSVC x64",
                               "compileCommands":  "${workspaceFolder}/compile_commands.json",
                               "intelliSenseMode":  "windows-msvc-x64",
                               "cppStandard":  "c++17",
                               "cStandard":  "c17",
                               "defines":  [
                                               "UNICODE",
                                               "_UNICODE",
                                               "QT_CORE_LIB",
