                                               "QT_WIDGETS_LIB",
                                               "QT_OPENGL_LIB",
                                               "QT_OPENGLWIDGETS_LIB"
                                           ],
                               "includePath":  [
                                                   "${workspaceFolder}",
                                                   "${workspaceFolder}/debug"
                                               ],
                               "browse":  {
                                              "path":  [
                                                           "${workspaceFolder}",
                                                           "${workspaceFolder}/debug"
                                                       ],
                                              "limitSymbolsToIncludedHeaders":  false
                                          }
                           }
                       ]
}
